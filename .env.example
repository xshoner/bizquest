# Server-side only (Cloudflare Pages function environment). Never expose in the client bundle.
GEMINI_API_KEY=replace-with-your-gemini-api-key
# Secondary key. Used immediately when the primary key has a quota, credential, network,
# Gemini 5xx, empty, truncated, or malformed-response failure.
GEMINI_API_KEY_2=
# Optional. Defaults to the Firebase project configured in src/firebase.js.
FIREBASE_PROJECT_ID=startup-5ec16
