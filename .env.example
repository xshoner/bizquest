# Server-side only (Cloudflare Pages function environment). Never expose in the client bundle.
GEMINI_API_KEY=replace-with-your-gemini-api-key
# Optional fallback keys. Used only for retryable quota, credential, and Gemini 5xx failures.
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=
# Optional. Defaults to the Firebase project configured in src/firebase.js.
FIREBASE_PROJECT_ID=startup-5ec16
