rules_version = '2';

// BizQuest Firestore security rules.
//
// Data layout
//   appSettings/global                                 landing/admin settings (teachers only)
//   teacherRegistry/{uid}                              public teacher profile list
//   users/{uid}/profile/account                        teacher account profile
//   users/{uid}/managedUsers/{managedUid}              teachers created by an admin teacher
//   users/{uid}/rooms/{roomId}                         classroom room (teams, phase, simulation state)
//   users/{uid}/rooms/{roomId}/students/{studentUid}   one document per student (anonymous auth uid)
//
// Principles
//   * Teachers (non-anonymous accounts) own everything under users/{uid}.
//   * Students sign in anonymously. They may only write their own student document and, when they
//     are the leader of a team, a small allow-list of fields on that single team.
//   * Every student write is scoped by the room's current phase so late edits cannot change a game
//     that has already moved on.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isAnonymous() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    function isTeacher() {
      return signedIn() && !isAnonymous();
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // ------------------------------------------------------------------ app-wide documents
    match /appSettings/{settingId} {
      allow read: if signedIn();
      allow write: if isTeacher();
    }

    match /teacherRegistry/{teacherUid} {
      allow read: if isTeacher();
      allow create, update: if isTeacher()
        && (request.auth.uid == teacherUid || request.resource.data.createdBy == request.auth.uid);
      allow delete: if isTeacher();
    }

    // ------------------------------------------------------------------ teacher-owned data
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      match /profile/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /managedUsers/{managedUid} {
        allow read, write: if isOwner(uid);
      }

      match /rooms/{roomId} {
        // Any signed-in user (students are anonymous) can follow the room in real time.
        allow read: if signedIn();
        allow create, delete: if isOwner(uid);
        allow update: if isOwner(uid) || studentTeamUpdate(uid, roomId);

        match /students/{studentUid} {
          allow read: if signedIn();
          // Teacher manages every student record (assign, move, kick).
          allow create, update, delete: if isOwner(uid);
          // Students manage only their own record.
          allow create: if isSelf(studentUid) && validStudentCreate();
          allow update: if isSelf(studentUid) && validStudentUpdate(uid, roomId);
        }
      }
    }

    // ------------------------------------------------------------------ student helpers
    function isSelf(studentUid) {
      return signedIn() && request.auth.uid == studentUid;
    }

    function studentKeys() {
      return ['uid', 'nickname', 'team', 'cLevelResult', 'investments', 'investmentSubmitted', 'joinedAt', 'updatedAt'];
    }

    function validNickname(nickname) {
      return nickname is string && nickname.size() >= 1 && nickname.size() <= 20;
    }

    function validStudentCreate() {
      let data = request.resource.data;
      return data.keys().hasOnly(studentKeys())
        && data.uid == request.auth.uid
        && validNickname(data.nickname)
        && (!('team' in data) || data.team == null)
        && (!('investments' in data) || data.investments is map)
        && (!('investmentSubmitted' in data) || data.investmentSubmitted is bool);
    }

    function roomStatus(uid, roomId) {
      return get(/databases/$(database)/documents/users/$(uid)/rooms/$(roomId)).data.status;
    }

    function validStudentUpdate(uid, roomId) {
      let data = request.resource.data;
      let changed = data.diff(resource.data).affectedKeys();
      let status = roomStatus(uid, roomId);
      return data.keys().hasOnly(studentKeys())
        && !changed.hasAny(['uid', 'joinedAt'])
        && (!changed.hasAny(['nickname']) || validNickname(data.nickname))
        && (!changed.hasAny(['team']) || canChangeTeam(uid, roomId))
        && (!changed.hasAny(['cLevelResult']) || status == 'C_LEVEL')
        && (!changed.hasAny(['investments', 'investmentSubmitted'])
            || (status == 'INVESTMENT' && data.investments is map && data.investmentSubmitted is bool));
    }

    function openTeam(teams, key) {
      return key == null || (key is string && key in teams
        && teams[key].get('teamSetupComplete', false) != true);
    }

    function canChangeTeam(uid, roomId) {
      let room = get(/databases/$(database)/documents/users/$(uid)/rooms/$(roomId)).data;
      return room.status == 'WAITING'
        && openTeam(room.teams, resource.data.get('team', null))
        && openTeam(room.teams, request.resource.data.get('team', null));
    }

    // ------------------------------------------------------------------ team (leader) helpers
    function myStudent(uid, roomId) {
      return get(/databases/$(database)/documents/users/$(uid)/rooms/$(roomId)/students/$(request.auth.uid)).data;
    }

    // Fields a team leader may change on their own team.
    function leaderTeamKeys() {
      return ['teamName', 'mascot', 'teamSlogan', 'teamSetupComplete', 'trendCard', 'techCard', 'idea', 'ideaSubmitted', 'aiEvaluation'];
    }

    // Fields that are only meaningful during the planning phases.
    function planningTeamKeys() {
      return ['trendCard', 'techCard', 'idea', 'ideaSubmitted', 'aiEvaluation'];
    }

    function studentTeamUpdate(uid, roomId) {
      let before = resource.data;
      let after = request.resource.data;
      let me = myStudent(uid, roomId);
      let teamKey = me.team;
      let teamBefore = before.teams[teamKey];
      let teamAfter = after.teams[teamKey];
      let changedTeamKeys = teamAfter.diff(teamBefore).affectedKeys();
      let isLeader = teamBefore.leaderId == request.auth.uid;
      return signedIn()
        && teamKey is string
        // Only the teams map (plus the notice fields) may change...
        && after.diff(before).affectedKeys().hasOnly(['teams', 'sysMessage', 'updatedAt'])
        && (!('sysMessage' in after) || (after.sysMessage is string && after.sysMessage.size() <= 200))
        // ...and only the student's own team inside it.
        && after.teams.diff(before.teams).affectedKeys().hasOnly([teamKey])
        && (
          // Leader: allow-listed fields, planning fields only while planning, never after teacher lock.
          (isLeader
            && changedTeamKeys.hasOnly(leaderTeamKeys())
            && (!changedTeamKeys.hasAny(['teamName', 'mascot', 'teamSlogan', 'teamSetupComplete'])
                || (before.status == 'WAITING' && teamBefore.get('teamSetupComplete', false) != true))
            && (!changedTeamKeys.hasAny(planningTeamKeys())
                || (before.status in ['CARD_SELECT', 'IDEATION', 'AI_EVALUATION']
                    && (!('ideaLocked' in teamBefore) || teamBefore.ideaLocked != true)))
            && (!changedTeamKeys.hasAny(['aiEvaluation']) || teamAfter.aiEvaluation == null)
            && (!changedTeamKeys.hasAny(['teamName']) || (teamAfter.teamName is string && teamAfter.teamName.size() <= 10))
            && (!changedTeamKeys.hasAny(['mascot', 'teamSlogan', 'teamSetupComplete'])
                || (before.status == 'WAITING'
                    && (!('mascot' in teamAfter) || teamAfter.mascot is string)
                    && (!('teamSlogan' in teamAfter) || (teamAfter.teamSlogan is string && teamAfter.teamSlogan.size() <= 40))
                    && (!('teamSetupComplete' in teamAfter) || teamAfter.teamSetupComplete is bool))))
          ||
          // Any team member: mid-simulation decision votes only.
          (changedTeamKeys.hasOnly(['midDecision'])
            && before.status == 'SIMULATION'
            && before.currentMonth == 12
            && teamBefore.midDecision is map
            && teamAfter.midDecision is map
            && teamBefore.midDecision.get('resolvedScenario', null) == null
            && teamAfter.midDecision.diff(teamBefore.midDecision).affectedKeys().hasOnly(['votes'])
            && teamBefore.midDecision.get('votes', {}).diff(teamAfter.midDecision.get('votes', {})).affectedKeys().hasOnly([request.auth.uid])
            && !(request.auth.uid in teamBefore.midDecision.get('votes', {}))
            && teamAfter.midDecision.votes[request.auth.uid] is string)
        );
    }
  }
}
